#!/usr/bin/env bash
#
# Køyrer Kjernekraft lokalt, og byggjer paa nytt naar noko endrar seg.
#
#   ./køyr            start, og bygg paa nytt naar .go-filer endra seg
#   ./køyr --ein-gong start ein gong, utan vaktar
#   ./køyr --stogg    stogg det som gjeng
#
# Malar, CSS og JS treng ingi omstart: dei vert lesne fraa disken for
# kvar soknad naar KJERNEKRAFT_ENV=development. Berre Go-kode krev bygg.

set -uo pipefail
cd "$(dirname "$0")"

# Porten gjeng vidare til tenaren og ikkje berre til `lsof` her nede.
# Han stod som ein rein skalvariabel fyrr, medan server.go batt 8080 skrive
# inn i koda: sette du PORT=9000, leita skriptet etter kven som heldt 9000
# medan tenaren batt 8080, og dei tvo tala hadde ingen ting med kvarandre
# aa gjera.
export PORT="${PORT:-18108}"
PID_FIL=".køyr.pid"
VAKT_FIL=".køyr.vakt"
LOGG=".køyr.logg"

# Ein fast nykel i utvikling, so ein ikkje vert logga ut kvar gong
# tenaren startar paa nytt. Han er *berre* til dette; i drift kjem han
# or umgjevnaden og skal vera tilfeldig.
export KJERNEKRAFT_SESSION_KEY="${KJERNEKRAFT_SESSION_KEY:-utvikling-berre-lokalt-ikkje-i-drift-0000}"
export KJERNEKRAFT_ENV=development

stogg() {
    # Vaktaren fyrst, og det er ikkje ein detalj: drep ein tenaren medan
    # vaktaren lever, byggjer han honom att med ein gong, og «--stogg»
    # ser ut til aa ikkje verka.
    #
    # Verre var det som hopa seg upp. `--stogg` drap tenaren og det som
    # heldt porten, og ingen ting meir — so kvar `./køyr` nokon hadde
    # starta laag att og gjekk `find . -name '*.go'` yver heile treet
    # kvart sekund, for alltid. Dei var fem og fyrti her ein dag. Dei
    # aat ingi merkande CPU kvar for seg, so ingen saag deim; det dei
    # aat var disk, og `go test ./handlers` gjekk fraa ni sekund til
    # fire og fyrti med 39 % CPU — han sat og venta paa fila.
    # Fila held ein pid per lina og ikkje berre den siste. Det er nettupp
    # det som let deim hopa seg upp: startar ein `./køyr` i tvo vindaugo,
    # skreiv den andre yver den fyrste, og den fyrste vart usynleg for
    # alle seinare `--stogg`.
    #
    # Me leita etter dei med `pgrep -f køyr` ei stund. Det var verre enn
    # feilen: mynsteret fann ogso *skalet* som hadde starta skriptet — ei
    # kommandolina som nemner «køyr» er ikkje det same som ein køyrande
    # vaktar — og skriptet drap si eigi mor, som tok med seg tenaren den
    # nett hadde starta. Ein pid ein hev skrive sjølv er den einaste ein
    # veit kva er.
    if [[ -f "$VAKT_FIL" ]]; then
        local vakt
        while read -r vakt; do
            [[ -n "$vakt" && "$vakt" != "$$" ]] && kill "$vakt" 2>/dev/null
        done < "$VAKT_FIL"
        rm -f "$VAKT_FIL"
    fi

    if [[ -f "$PID_FIL" ]]; then
        kill "$(cat "$PID_FIL")" 2>/dev/null
        rm -f "$PID_FIL"
    fi
    # Alt som held porten, ogso fraa ei tidlegare økt.
    local pidar
    pidar=$(lsof -ti ":$PORT" 2>/dev/null || true)
    [[ -n "$pidar" ]] && kill $pidar 2>/dev/null

    # Vent til porten *faktisk* er fri. Utan dette startar den nye
    # tenaren fyre den gamle hev sleppt taket, han fær «address already
    # in use», og skriptet melder feil medan den gamle framleis svarar.
    # Daa ser ein gamal kode og trur ein ser ny.
    for _ in $(seq 20); do
        lsof -ti ":$PORT" >/dev/null 2>&1 || return 0
        sleep 0.15
    done
    pidar=$(lsof -ti ":$PORT" 2>/dev/null || true)
    [[ -n "$pidar" ]] && kill -9 $pidar 2>/dev/null
    sleep 0.2
    return 0
}

start() {
    if ! go build -o .kjernekraft-bin . 2>build.feil; then
        echo "  ✗ bygget feila:"
        sed 's/^/    /' build.feil
        rm -f build.feil
        return 1
    fi
    rm -f build.feil
    ./.kjernekraft-bin >>"$LOGG" 2>&1 &
    echo $! > "$PID_FIL"
    sleep 0.6
    if kill -0 "$(cat "$PID_FIL")" 2>/dev/null; then
        echo "  ✓ http://localhost:$PORT"
    else
        echo "  ✗ tenaren stogga med ein gong — sjaa $LOGG"
        tail -5 "$LOGG" | sed 's/^/    /'
        return 1
    fi
}

case "${1:-}" in
    --stogg) stogg; echo "  stogga."; exit 0 ;;
esac

trap 'echo; stogg; echo "  stogga."; exit 0' INT TERM

stogg
: > "$LOGG"
echo "Kjernekraft"
start || exit 1

if [[ "${1:-}" == "--ein-gong" ]]; then
    echo "  (utan vaktar — ./køyr utan flagg byggjer paa nytt av seg sjølv)"
    wait
fi

# `stat` talar tvo maal. BSD (macOS) vil ha `-f '%m'`, GNU (Linux) vil ha
# `-c '%Y'`. Skriptet nytta berre BSD-forma, og paa Linux gav ho tom
# utgreiding kvar gong: SIST og NAA var baae tome, dei var alltid like,
# og vaktaren bygde aldri paa nytt. Han sa framleis «vaktar Go-filer»,
# so ein sat og undra seg yver kvifor endringane ikkje synte seg.
if stat -c '%Y' . >/dev/null 2>&1; then
    STATFLAGG=(-c '%Y')      # GNU
else
    STATFLAGG=(-f '%m')      # BSD
fi

nyaste() {
    find . -name '*.go' -not -path './.git/*' -exec stat "${STATFLAGG[@]}" {} + 2>/dev/null |
        sort -rn | head -1
}

# Vaktaren skriv seg sjølv i fila, so ei seinare `--stogg` finn honom.
# `>>` og ikkje `>`: fleire vaktarar skal alle staa der, ikkje berre den
# siste.
echo $$ >> "$VAKT_FIL"

echo "  vaktar Go-filer. ctrl-c stoggar."
SIST=$(nyaste)
while true; do
    sleep 1
    NAA=$(nyaste)
    if [[ "$NAA" != "$SIST" ]]; then
        SIST="$NAA"
        echo "  … endring, byggjer"
        stogg
        start || echo "  (held fram med aa vakta)"
    fi
done
