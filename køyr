#!/usr/bin/env bash
#
# Køyrer Kjernekraft lokalt, og byggjer paa nytt naar noko endrar seg.
#
#   ./køyr            start, og bygg paa nytt naar .go-filer endra seg
#   ./køyr --ein-gong start ein gong, utan vaktar
#   ./køyr --stogg    stogg det som gjeng
#
# Malar, CSS og JS treng ingi omstart: dei vert lesne fraa disken for
# kvar soknad naar KJERNEKRAFT_ENV=development. Berre Go-kode krev bygg.

set -uo pipefail
cd "$(dirname "$0")"

PORT="${PORT:-8080}"
PID_FIL=".køyr.pid"
LOGG=".køyr.logg"

# Ein fast nykel i utvikling, so ein ikkje vert logga ut kvar gong
# tenaren startar paa nytt. Han er *berre* til dette; i drift kjem han
# or umgjevnaden og skal vera tilfeldig.
export KJERNEKRAFT_SESSION_KEY="${KJERNEKRAFT_SESSION_KEY:-utvikling-berre-lokalt-ikkje-i-drift-0000}"
export KJERNEKRAFT_ENV=development

stogg() {
    if [[ -f "$PID_FIL" ]]; then
        kill "$(cat "$PID_FIL")" 2>/dev/null
        rm -f "$PID_FIL"
    fi
    # Alt som held porten, ogso fraa ei tidlegare økt.
    local pidar
    pidar=$(lsof -ti ":$PORT" 2>/dev/null || true)
    [[ -n "$pidar" ]] && kill $pidar 2>/dev/null

    # Vent til porten *faktisk* er fri. Utan dette startar den nye
    # tenaren fyre den gamle hev sleppt taket, han fær «address already
    # in use», og skriptet melder feil medan den gamle framleis svarar.
    # Daa ser ein gamal kode og trur ein ser ny.
    for _ in $(seq 20); do
        lsof -ti ":$PORT" >/dev/null 2>&1 || return 0
        sleep 0.15
    done
    pidar=$(lsof -ti ":$PORT" 2>/dev/null || true)
    [[ -n "$pidar" ]] && kill -9 $pidar 2>/dev/null
    sleep 0.2
    return 0
}

start() {
    if ! go build -o .kjernekraft-bin . 2>build.feil; then
        echo "  ✗ bygget feila:"
        sed 's/^/    /' build.feil
        rm -f build.feil
        return 1
    fi
    rm -f build.feil
    ./.kjernekraft-bin >>"$LOGG" 2>&1 &
    echo $! > "$PID_FIL"
    sleep 0.6
    if kill -0 "$(cat "$PID_FIL")" 2>/dev/null; then
        echo "  ✓ http://localhost:$PORT"
    else
        echo "  ✗ tenaren stogga med ein gong — sjaa $LOGG"
        tail -5 "$LOGG" | sed 's/^/    /'
        return 1
    fi
}

case "${1:-}" in
    --stogg) stogg; echo "  stogga."; exit 0 ;;
esac

trap 'echo; stogg; echo "  stogga."; exit 0' INT TERM

stogg
: > "$LOGG"
echo "Kjernekraft"
start || exit 1

if [[ "${1:-}" == "--ein-gong" ]]; then
    echo "  (utan vaktar — ./køyr utan flagg byggjer paa nytt av seg sjølv)"
    wait
fi

echo "  vaktar Go-filer. ctrl-c stoggar."
SIST=$(find . -name '*.go' -not -path './.git/*' -newer /dev/null -exec stat -f '%m' {} + 2>/dev/null | sort -rn | head -1)
while true; do
    sleep 1
    NAA=$(find . -name '*.go' -not -path './.git/*' -exec stat -f '%m' {} + 2>/dev/null | sort -rn | head -1)
    if [[ "$NAA" != "$SIST" ]]; then
        SIST="$NAA"
        echo "  … endring, byggjer"
        stogg
        start || echo "  (held fram med aa vakta)"
    fi
done
