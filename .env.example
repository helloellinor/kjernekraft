# Økt-nykelen. Utan honom startar ikkje tenaren.
#
#   openssl rand -base64 32
#
# Han skal vera ulik i drift og paa maskini di, og han skal aldri
# koma inn i repoet.
KJERNEKRAFT_SESSION_KEY=

# Set han til «development» medan du arbeider paa http://localhost.
# Daa gjeng kakone utan Secure-flagget, og testdata-rutorne svara.
# Alt anna — og det tome — vert handsama som drift.
KJERNEKRAFT_ENV=development
